<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_title"
        android:textColor="@color/widget_text_accent"
        android:textSize="11sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/widget_mic"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_mic_circle"
        android:contentDescription="@string/widget_speak"
        android:padding="14dp"
        android:src="@drawable/ic_mic_widget" />

    <TextView
        android:id="@+id/widget_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/widget_speak"
        android:textColor="@color/widget_text_primary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/widget_status_ready"
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp" />

</LinearLayout>